# Contact form delivery — server-side only, never prefix with NEXT_PUBLIC_.
# The form posts to /api/contact, which sends through Resend.
RESEND_API_KEY=

# Where enquiries land.
CONTACT_TO=mburudave@gmail.com

# Sender. `onboarding@resend.dev` works without a verified domain but only
# delivers to the Resend account owner; switch to a domain address once
# resend.com/domains has verified one.
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Optional: override the provider endpoint (used for local stubs/tests).
# RESEND_API_URL=http://127.0.0.1:4099/emails
